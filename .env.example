# Expo uses app.json extra{} for runtime config, not .env files.
# For EAS Build, set these in eas.json env or via: eas secret:create
#
# Local dev: edit app.json → expo.extra.apiUrl
# EAS:       eas env:create --scope project --name EXPO_PUBLIC_API_URL --value https://aroge-api.onrender.com/api/v1

# Reference only — actual values go in eas.json or EAS dashboard
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=ArogeBot

# EAS CLI token (for CI only — never commit)
# Set as GitHub secret: EXPO_TOKEN
EXPO_TOKEN=your_expo_token_here
