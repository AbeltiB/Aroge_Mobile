{
  "cli": {
    "version": ">= 12.0.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/api/v1",
        "EXPO_PUBLIC_TELEGRAM_BOT_USERNAME": "aroge_telegram_bot"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aroge-api.onrender.com/api/v1",
        "EXPO_PUBLIC_TELEGRAM_BOT_USERNAME": "aroge_telegram_bot"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aroge-api.onrender.com/api/v1",
        "EXPO_PUBLIC_TELEGRAM_BOT_USERNAME": "aroge_telegram_bot"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aroge-api.onrender.com/api/v1",
        "EXPO_PUBLIC_TELEGRAM_BOT_USERNAME": "aroge_telegram_bot"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "internal"
      }
    }
  }
}
